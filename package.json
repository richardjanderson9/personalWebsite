{
  "name": "personalWebsite",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "My personal website built with React, Vite, and Tailwind CSS. It showcases my portfolio, blog, and contact information. The website is designed to be fast, responsive, and user-friendly, providing visitors with an engaging experience. It is configured to sit behind a Cloudflare Proxy/WAF for enhanced security and performance.",
  "author": {
    "name": "Richard Anderson",
    "linkedin": "https://www.linkedin.com/in/richardjanderson9/"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write src/**/*.{jsx,css,json,md}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richardjanderson9/personalWebsite/"
  },
  "bugs": {
    "url": "https://github.com/richardjanderson9/personalWebsite/issues"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "postcss": "^8.4.31"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}