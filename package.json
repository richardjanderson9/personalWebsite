{
  "name": "react-website",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "My personal website built with React, Vite, and Tailwind CSS. It showcases my portfolio, blog, and contact information. The website is designed to be fast, responsive, and user-friendly, providing visitors with an engaging experience. It is configured to sit behind a Cloudflare Proxy/WAF for enhanced security and performance. ",
  "author": {
    "name": "Richard Anderson",
    "linkedin": "https://www.linkedin.com/in/richardjanderson9"
  },
  "license": "MIT",
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "npm-check": "^6.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.jsx",
    "lint:fix": "eslint src/**/*.jsx --fix",
    "format": "prettier --write src/**/*.{jsx,css,json,md}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richardjanderson9/react-website"
  },
  "bugs": {
    "url": "https://github.com/richardjanderson9/react-website/issues"
  },
  "homepage": "http://localhost:3000",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-config-react-app": "^7.0.1",
    "husky": "^9.1.7",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=11.4.2"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.31",
    "serialize-javascript": "^6.0.2",
    "inflight": "^1.0.6"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run test"
    }
  },
  "template": true
}
